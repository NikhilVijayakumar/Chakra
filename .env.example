# Copy to .env (gitignored). Backend CLI reads CHAKRA_* only.
CHAKRA_SPREADSHEET_ID=
CHAKRA_SERVICE_ACCOUNT_PATH=config/<service-account>.json
CHAKRA_AGENTMAIL_API_KEY=
CHAKRA_AGENTMAIL_INBOX_ID=
# Per-machine (each OS/machine keeps its own .env). Absolute path to the cache/config dir; unset = OS default.
# Linux:   CHAKRA_HOME=/home/<user>/.local/share/chakra
# Windows: CHAKRA_HOME=E:/Python/Chakra/data/cache
CHAKRA_HOME=

# --- Build output (scripts/build.py). All optional; default is ./dist. Per machine, like CHAKRA_HOME.
# Release (library tarball + CLI folder + Windows installer):
CHAKRA_BUILD_DIR=
# Dev (CLI folder + frontend/dist-lib in place + run-ui launcher); falls back to CHAKRA_BUILD_DIR.
# CHAKRA_DEV_DIR=
# Or separate release folders (these win over CHAKRA_BUILD_DIR):
# CHAKRA_BUILD_LIB_DIR=
# CHAKRA_BUILD_CLI_DIR=
# Linux:   CHAKRA_BUILD_DIR=/home/<user>/chakra-build
# Windows: CHAKRA_BUILD_DIR=E:/Python/Chakra/build-out
