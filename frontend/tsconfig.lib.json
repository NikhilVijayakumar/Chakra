{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "jsx": "react-jsx",
    "strict": true,
    "declaration": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist-lib",
    "rootDir": "src/library",
    "types": ["node"]
  },
  "include": ["src/library/**/*"],
  "exclude": ["src/library/**/*.test.ts", "src/library/**/*.test.tsx"]
}
